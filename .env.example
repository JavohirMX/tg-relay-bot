BOT_TOKEN=123456789:replace-with-your-bot-token
ADMIN_TELEGRAM_ID=123456789
DATABASE_PATH=data/relay_bot.sqlite3

# Balanced default: normal conversation is fine, bursts get cooled down.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_MESSAGES=20
RATE_LIMIT_COOLDOWN_SECONDS=300

WELCOME_TEXT="Hi. You can message me here without seeing my personal Telegram account. Be respectful and avoid spam; abusive messages may be blocked."
